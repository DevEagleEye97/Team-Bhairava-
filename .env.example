# HackForge Digital Team Desk & Collaborative Workspace
# Environment Variables Configuration

# 1. Supabase Backend & Database
# Obtained from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# 2. AI Assistant & Dashboard Copilot
# Get a Google Gemini API Key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
AI_MODEL=gemini-2.0-flash

# Optional: OpenAI API Key (if using OpenAI instead of Gemini)
# OPENAI_API_KEY=
